# Base URL of the backend API. In local dev it points at your local server.
# For production (Vercel), set this in Project > Settings > Environment
# Variables (see DEPLOYMENT.md), then redeploy.
VITE_API_URL="http://localhost:5000/api"

# Public site details shown in the footer, contact and help pages (defaults are the production values)
# Optional: Web Vitals endpoint. Leave empty to disable.
VITE_WEB_VITALS_ENDPOINT=""

VITE_SITE_URL="https://kavachfitness.in"
VITE_SUPPORT_EMAIL="support@kavachfitness.in"
VITE_SUPPORT_PHONE="+919876543210"
