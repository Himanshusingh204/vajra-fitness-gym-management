PORT=5000
NODE_ENV=development

# PostgreSQL. Start the local dev DB with `docker compose up -d db` (see docker-compose.yml),
# or point this at your own Postgres instance.
DATABASE_URL="postgresql://vajra_admin:vajra_secure_pass@localhost:5432/vajra_fitness?schema=public"

# MUST be set to a random value of at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change_me_to_a_long_random_secret_of_32_plus_chars"

# Public origin used to build activation / reset links (must match the deployed frontend).
FRONTEND_URL="http://localhost:5173"

# Extra browser origins allowed by CORS, comma-separated. FRONTEND_URL is always allowed.
# Example for production: CORS_ORIGINS="https://your-app.netlify.app"
CORS_ORIGINS=""

# Trust proxies so rate limiting / client IP work behind nginx, Cloud Run, etc.
# Set to the number of trusted proxy hops (typically 1) when deployed behind a reverse proxy.
TRUST_PROXY="0"

# Redis (OPTIONAL) — shared rate limiting + brute-force lockout across multiple
# instances. Leave empty for a single instance (falls back to in-memory state).
# Example: REDIS_URL="redis://:password@host:6379"
REDIS_URL=""

# Structured logging level: debug | info | warn | error. Logs are JSON lines with
# a per-request correlation id (echoed as X-Request-Id).
LOG_LEVEL="info"

# Prometheus scrape protection (optional). When set, /metrics requires:
#   Authorization: Bearer <METRICS_TOKEN>
METRICS_TOKEN=""

# SMTP — REQUIRED in production so activation and password-reset emails are actually delivered.
# In development with no SMTP configured, links are logged to the server console instead.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Vajra Fitness <no-reply@vajrafitness.in>"

# Razorpay — enables online payments for pending fees. Until BOTH a key id and
# key secret are set, the API reports ONLINE_PAYMENTS_DISABLED and the UI shows
# the "configure payments" note instead of a Pay Online button.
# Get test keys at https://dashboard.razorpay.com/app/keys (razorpay-test mode).
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Webhook secret from Dashboard → Settings → Webhooks. Required only if you
# configure the payment.captured webhook URL: {API_URL}/api/payments/webhook
RAZORPAY_WEBHOOK_SECRET=""

# SaaS Configuration
# Default grace period in days after subscription expiry (before restricted access)
GRACE_PERIOD_DAYS="3"
# Default trial duration in days
DEFAULT_TRIAL_DAYS="7"
