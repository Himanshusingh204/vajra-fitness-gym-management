PORT=5000
NODE_ENV=development

# PostgreSQL. Point this at any local Postgres instance, or a free Neon
# project for both local dev and production (see DEPLOYMENT.md).
#
# If using Neon and things feel slow: check the "Compute" tab in the Neon
# console for autosuspend settings. The free tier suspends the compute
# after a few idle minutes, and the next query pays a multi-second
# cold-start tax to wake it back up — this is a bigger, more consistent
# cause of slow requests than query shape once N+1 patterns are fixed.
# Disabling autosuspend (paid tiers) or keeping the app's own keep-alive
# ping running (backend/src/server.ts) mitigates it during active use.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vajra_fitness?schema=public"
#
# To develop against the local QA database without touching the one above, run
# `npm run dev:local` (uses vajra_fitness_qa on localhost, or LOCAL_DATABASE_URL).
# When the database can't be reached the API answers 503 { code: "DB_UNREACHABLE" }.

# MUST be set to a random value of at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change_me_to_a_long_random_secret_of_32_plus_chars"

# Public origin used to build activation / reset links (must match the deployed frontend).
FRONTEND_URL="http://localhost:5173"

# Extra browser origins allowed by CORS, comma-separated. FRONTEND_URL is always allowed.
# Example for production: CORS_ORIGINS="https://your-app.vercel.app"
CORS_ORIGINS=""

# Trust proxies so rate limiting / client IP work behind nginx, Cloud Run, etc.
# Set to the number of trusted proxy hops (typically 1) when deployed behind a reverse proxy.
TRUST_PROXY="0"

# Redis — shared rate limiting, brute-force lockout, and dashboard/analytics
# read caching. Technically optional (falls back to in-memory, single-instance
# state if empty), but strongly recommended even for a single small deployment:
# without it, dashboard/analytics endpoints re-run their full query set on
# every poll instead of hitting a short-lived cache, which is the difference
# between sub-second and multi-second dashboard loads.
# Free managed option: Upstash (upstash.com) — Redis DB → Connect → copy the
# `rediss://` (TLS) connection string.
# Example: REDIS_URL="rediss://default:password@host.upstash.io:6379"
REDIS_URL=""

# Structured logging level: debug | info | warn | error. Logs are JSON lines with
# a per-request correlation id (echoed as X-Request-Id).
LOG_LEVEL="info"

# Prometheus scrape protection (optional). When set, /metrics requires:
#   Authorization: Bearer <METRICS_TOKEN>
METRICS_TOKEN=""

# SMTP — REQUIRED in production so activation and password-reset emails are actually delivered.
# In development with no SMTP configured, links are logged to the server console instead.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Kavach Fitness <no-reply@example.com>"

# Razorpay — enables online payments for pending fees. Until BOTH a key id and
# key secret are set, the API reports ONLINE_PAYMENTS_DISABLED and the UI shows
# the "configure payments" note instead of a Pay Online button.
# Get test keys at https://dashboard.razorpay.com/app/keys (razorpay-test mode).
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Webhook secret from Dashboard → Settings → Webhooks. Required only if you
# configure the payment.captured webhook URL: {API_URL}/api/payments/webhook
RAZORPAY_WEBHOOK_SECRET=""

# Public site origin used in the generated sitemap. Defaults to the Vercel deployment.
PUBLIC_SITE_URL=""

# Set to 1 only to run the seed scripts against NODE_ENV=production.
ALLOW_PRODUCTION_SEED=""

# Shared secret for the scheduled-jobs endpoint (/api/internal/cron). Vercel Cron sends it as
# "Authorization: Bearer $CRON_SECRET"; without it the endpoint always answers 401.
CRON_SECRET=""

# GST percentage applied on SaaS subscription invoices
GST_RATE=18

# Where uploaded documents and photos are stored (local disk). Defaults to backend/uploads.
UPLOAD_DIR=""

# Time zone that decides when a gym day starts (attendance check-ins, today counts)
APP_TIMEZONE="Asia/Kolkata"
