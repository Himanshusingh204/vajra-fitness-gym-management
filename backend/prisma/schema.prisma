generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// =====================================================================
// CORE USER & AUTH
// =====================================================================

model User {
  id           String   @id @default(uuid())
  username     String
  email        String   @unique
  password     String
  role         String   @default("MEMBER") // SUPER_ADMIN, GYM_ADMIN, BRANCH_ADMIN, MANAGER, MEMBER, TRAINER, STAFF
  phone        String?
  isActive     Boolean  @default(true)
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedGyms      Gym[]           @relation("GymOwner")
  memberProfiles MemberDetails[]
  trainerDetails TrainerDetails?
  staffDetails   StaffDetails?
  supportTickets SupportTicket[]
  auditLogs      AuditLog[]

  bookingsAsMember  Booking[]       @relation("MemberBookings")
  bookingsAsTrainer Booking[]       @relation("TrainerBookings")
  progressLogs      ProgressLog[]
  nutritionPlans    NutritionPlan[]

  notifications       Notification[]
  activationToken     ActivationToken?
  passwordResetTokens PasswordResetToken[]
  refreshTokens       RefreshToken[]
  Payslip             Payslip[]
  documents           Document[]

  approvalRequests  ApprovalRequest[] @relation("ApprovalRequester")
  reviewedApprovals ApprovalRequest[] @relation("ApprovalReviewer")
  approvalEvents    ApprovalEvent[]
  trainerInvites    TrainerInvite[]
  orders            Order[]

  @@index([email])
}

// =====================================================================
// GYM & MULTI-BRANCH
// =====================================================================

model Gym {
  id         String   @id @default(uuid())
  name       String
  address    String
  city       String
  state      String
  location   String?
  gstNumber  String?
  logoUrl    String?
  imageUrl   String?
  // Facility names, picked from the platform Facility list.
  facilities String[] @default([])
  // isApproved mirrors status == APPROVED until every read uses status.
  isApproved Boolean  @default(false)
  status     String   @default("DRAFT") // DRAFT, PENDING_REVIEW, CHANGES_REQUESTED, APPROVED, REJECTED, SUSPENDED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  slug            String? @unique
  category        String?
  lat             Float?
  lng             Float?
  postalCode      String?
  establishedYear Int?
  parking         String?
  accessibility   String?
  rules           String?

  // White-label branding (Phase 2 #9)
  brandColor   String? // hex, e.g. #800020
  tagline      String? // short marketing line for the branded portal
  subdomain    String? @unique // e.g. "andheri" -> andheri.<base>.com
  customDomain String? @unique // fully-qualified custom domain, e.g. gym.example.com

  // Public profile shown on /gyms/:id and /g/:slug
  description  String?
  phone        String?
  email        String?
  openingHours String?
  galleryUrls  String[] @default([])

  ownerId         String
  owner           User                  @relation("GymOwner", fields: [ownerId], references: [id])
  membershipPlans MembershipPlan[]
  websiteRequests GymWebsiteRequest[]
  members         MemberDetails[]
  trainers        TrainerDetails[]
  staff           StaffDetails[]
  fees            Fee[]
  workoutSlips    WorkoutSlip[]
  attendances     Attendance[]
  notices         Notice[]
  Enquiry         Enquiry[]
  bookings        Booking[]
  memberships     Membership[]
  subscriptions   GymSubscription[]
  branches        Branch[]
  classes         GymClass[]
  expenses        Expense[]
  equipment       Equipment[]
  products        Product[]
  sales           Sale[]
  invoices        SubscriptionInvoice[]
  payrollRecords  Payslip[]
  documents       Document[]
  approvals       ApprovalRequest[]
  trainerInvites  TrainerInvite[]
  orders          Order[]
  ledgerEntries   LedgerEntry[]
  commissionRule  CommissionRule?

  @@index([status, city])
  @@index([lat, lng])
}

model Branch {
  id        String   @id @default(uuid())
  name      String
  address   String
  city      String
  state     String
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Approval workflow: new branches start PENDING and are not usable until a
  // Super Admin approves them. Existing branches default to APPROVED so this
  // migration doesn't disrupt gyms already operating multiple locations.
  status          String    @default("APPROVED") // PENDING, APPROVED, REJECTED
  rejectionReason String?
  reviewedAt      DateTime?
  reviewedBy      String?

  gymId String
  gym   Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)

  members  MemberDetails[]
  trainers TrainerDetails[]
  staff    StaffDetails[]
  classes  GymClass[]

  @@index([gymId])
}

// =====================================================================
// MEMBERSHIP PLANS
// =====================================================================

model MembershipPlan {
  id          String   @id @default(uuid())
  name        String
  description String?
  duration    Int // Duration in days
  price       Decimal  @db.Decimal(10, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  gymId       String
  gym         Gym             @relation(fields: [gymId], references: [id], onDelete: Cascade)
  members     MemberDetails[]
  memberships Membership[]
  orders      Order[]

  @@index([gymId])
}

// =====================================================================
// MEMBER DETAILS
// =====================================================================

model MemberDetails {
  id                     String    @id @default(uuid())
  joiningDate            DateTime  @default(now())
  status                 String    @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED, PENDING, FROZEN, EXPIRED
  preferredPaymentMethod String?
  gender                 String?
  dateOfBirth            DateTime?
  address                String?
  emergencyContact       String?
  referralCode           String?   @unique
  referredBy             String?

  // One row per user per gym: a user can be a member at several gyms.
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  gymId          String
  gym            Gym             @relation(fields: [gymId], references: [id], onDelete: Cascade)
  branchId       String?
  branch         Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  planId         String?
  membershipPlan MembershipPlan? @relation(fields: [planId], references: [id])

  fees          Fee[]
  workoutSlips  WorkoutSlip[]
  attendances   Attendance[]
  memberships   Membership[]
  classBookings ClassBooking[]

  @@unique([userId, gymId])
  @@index([gymId])
  @@index([userId])
  @@index([branchId])
  @@index([referralCode])
}

// =====================================================================
// TRAINER DETAILS
// =====================================================================

model TrainerDetails {
  id              String   @id @default(uuid())
  specialization  String?
  bio             String?
  commissionRate  Decimal? @db.Decimal(5, 2) // percentage commission on PT revenue
  hourlyRate      Decimal? @db.Decimal(10, 2)
  joiningDate     DateTime @default(now())
  // Invited and self-registered trainers need the gym owner's approval.
  // Trainers added by a gym admin are APPROVED straight away.
  status          String   @default("ACTIVE") // INVITED, DRAFT, PENDING_REVIEW, CHANGES_REQUESTED, APPROVED, REJECTED, SUSPENDED
  experienceYears Int?
  city            String?

  userId         String                 @unique
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  gymId          String
  gym            Gym                    @relation(fields: [gymId], references: [id], onDelete: Cascade)
  branchId       String?
  branch         Branch?                @relation(fields: [branchId], references: [id], onDelete: SetNull)
  WorkoutSlip    WorkoutSlip[]
  classes        GymClass[]
  qualifications TrainerQualification[]
  availability   TrainerAvailability[]

  @@index([gymId])
  @@index([branchId])
}

model TrainerQualification {
  id         String    @id @default(uuid())
  title      String
  issuer     String?
  year       Int?
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  trainerId  String
  trainer    TrainerDetails @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  documentId String?
  document   Document?      @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([trainerId])
}

// Weekly hours a trainer takes sessions, in minutes from midnight (gym time).
model TrainerAvailability {
  id          String @id @default(uuid())
  weekday     Int // 0 = Sunday
  startMinute Int
  endMinute   Int

  trainerId String
  trainer   TrainerDetails @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@index([trainerId, weekday])
}

// Only the sha256 of the invite token is stored; the plain token is in the emailed link.
model TrainerInvite {
  id         String    @id @default(uuid())
  email      String
  name       String?
  tokenHash  String    @unique
  status     String    @default("PENDING") // PENDING, ACCEPTED, REVOKED (expiry is read from expiresAt)
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  gymId       String
  gym         Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)
  invitedById String
  invitedBy   User   @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@index([email])
}

// =====================================================================
// STAFF DETAILS
// =====================================================================

model StaffDetails {
  id          String   @id @default(uuid())
  role        String
  joiningDate DateTime @default(now())
  salary      Decimal? @db.Decimal(10, 2)

  userId     String       @unique
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  gymId      String
  gym        Gym          @relation(fields: [gymId], references: [id], onDelete: Cascade)
  branchId   String?
  branch     Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  Attendance Attendance[]

  @@index([gymId])
  @@index([branchId])
}

// =====================================================================
// FEES & PAYMENTS
// =====================================================================

model Fee {
  id             String    @id @default(uuid())
  amount         Decimal   @db.Decimal(10, 2)
  paymentDate    DateTime  @default(now())
  dueDate        DateTime
  status         String    @default("PAID") // PAID, PENDING, OVERDUE, PARTIAL
  paymentMethod  String?
  transactionId  String?
  notes          String?
  reminderSentAt DateTime?
  discount       Decimal   @default(0) @db.Decimal(10, 2)
  tax            Decimal   @default(0) @db.Decimal(10, 2)
  taxRate        Decimal   @default(0) @db.Decimal(5, 2)
  gstType        String? // CGST_SGST, IGST

  memberId     String
  member       MemberDetails @relation(fields: [memberId], references: [id], onDelete: Cascade)
  gymId        String
  gym          Gym           @relation(fields: [gymId], references: [id], onDelete: Cascade)
  membershipId String?
  membership   Membership?   @relation(fields: [membershipId], references: [id], onDelete: SetNull)

  paymentOrders PaymentOrder[]

  @@index([gymId])
  @@index([memberId])
  @@index([membershipId])
  @@index([status])
  @@index([gymId, status])
  @@index([gymId, dueDate])
  @@index([gymId, paymentDate])
}

model PaymentOrder {
  id        String   @id @default(uuid())
  orderId   String   @unique
  amount    Int
  currency  String   @default("INR")
  status    String   @default("CREATED") // CREATED, PAID, FAILED
  paymentId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  feeId String
  fee   Fee    @relation(fields: [feeId], references: [id], onDelete: Cascade)

  @@index([feeId])
  @@index([status])
  @@index([orderId])
}

// =====================================================================
// MARKETPLACE ORDERS & LEDGER
// =====================================================================

// A member buying a plan through Kavach. All amounts are paise; see splitOrder.
model Order {
  id                 String    @id @default(uuid())
  idempotencyKey     String
  planSnapshot       Json // name, duration, price at the time of purchase
  basePaise          Int
  gstPaise           Int
  totalPaise         Int
  commissionBps      Int
  commissionPaise    Int
  commissionGstPaise Int
  gymNetPaise        Int
  status             String    @default("CREATED") // CREATED, PAID, FAILED, REFUNDED
  razorpayOrderId    String?   @unique
  razorpayPaymentId  String?
  paidAt             DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  memberUserId String
  memberUser   User            @relation(fields: [memberUserId], references: [id], onDelete: Restrict)
  gymId        String
  gym          Gym             @relation(fields: [gymId], references: [id], onDelete: Restrict)
  planId       String?
  plan         MembershipPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  membershipId String?         @unique
  membership   Membership?     @relation(fields: [membershipId], references: [id], onDelete: SetNull)

  ledgerEntries LedgerEntry[]
  refunds       Refund[]

  @@unique([memberUserId, idempotencyKey])
  @@index([gymId, status])
}

// Raw Razorpay webhook events, kept for audit and so a redelivery is a no-op.
model PaymentEvent {
  id              String    @id @default(uuid())
  providerEventId String    @unique
  type            String
  payload         Json
  processedAt     DateTime?
  createdAt       DateTime  @default(now())
}

// gymId null is the platform default; a row with a gymId overrides it.
model CommissionRule {
  id         String   @id @default(uuid())
  percentBps Int // 1000 = 10%
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  gymId String? @unique
  gym   Gym?    @relation(fields: [gymId], references: [id], onDelete: Cascade)
}

// Append-only. The rows for one order sum to zero: MEMBER_PAID is -total, and
// GYM_PAYABLE, PLATFORM_COMMISSION and GST_PAYABLE are the positive shares.
// A gym's payable balance is SUM(amountPaise) of its GYM_PAYABLE (and later PAYOUT) rows.
model LedgerEntry {
  id          String   @id @default(uuid())
  account     String // MEMBER_PAID, GYM_PAYABLE, PLATFORM_COMMISSION, GST_PAYABLE
  amountPaise Int
  sourceType  String // ORDER, REFUND
  sourceId    String
  createdAt   DateTime @default(now())

  gymId   String
  gym     Gym     @relation(fields: [gymId], references: [id], onDelete: Restrict)
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([sourceType, sourceId, account])
  @@index([gymId, account])
  @@index([orderId])
}

model Refund {
  id               String   @id @default(uuid())
  amountPaise      Int
  reason           String?
  status           String   @default("REQUESTED") // REQUESTED, PROCESSED, FAILED
  razorpayRefundId String?  @unique
  requestedById    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
}

// =====================================================================
// MEMBERSHIP LIFECYCLE
// =====================================================================

model Membership {
  id                   String    @id @default(uuid())
  startDate            DateTime
  endDate              DateTime
  originalAmount       Decimal   @db.Decimal(10, 2)
  discount             Decimal   @default(0) @db.Decimal(10, 2)
  finalAmount          Decimal   @db.Decimal(10, 2)
  paymentStatus        String    @default("PENDING") // PENDING, PAID, PARTIAL, OVERDUE
  status               String    @default("PENDING") // PENDING, ACTIVE, EXPIRED, SUSPENDED, CANCELLED, FROZEN
  paymentMethod        String?
  transactionId        String?
  notes                String?
  isRenewal            Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  expiryReminderSentAt DateTime?
  frozenAt             DateTime?
  unfrozenAt           DateTime?
  freezeReason         String?

  memberId String
  member   MemberDetails   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  gymId    String
  gym      Gym             @relation(fields: [gymId], references: [id], onDelete: Cascade)
  planId   String?
  plan     MembershipPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  previousMembershipId String?
  previousMembership   Membership?  @relation("RenewalChain", fields: [previousMembershipId], references: [id], onDelete: SetNull)
  renewals             Membership[] @relation("RenewalChain")

  fees  Fee[]
  order Order?

  @@index([memberId])
  @@index([gymId])
  @@index([status])
  @@index([endDate])
  @@index([paymentStatus])
  @@index([gymId, status, endDate])
  @@index([gymId, status, endDate, memberId])
}

// =====================================================================
// NOTIFICATIONS
// =====================================================================

model Notification {
  id        String    @id @default(uuid())
  type      String    @default("INFO") // INFO, SUCCESS, WARNING, ERROR
  title     String
  message   String
  isRead    Boolean   @default(false)
  readAt    DateTime?
  link      String?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@index([userId, isRead, createdAt])
}

// =====================================================================
// AUTH TOKENS
// =====================================================================

// Only the sha256 of a one-time token is stored; the plain token lives in the emailed link.
model ActivationToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  familyId  String
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

// =====================================================================
// SaaS PLANS (sold to gym owners)
// =====================================================================

model SaaSPlan {
  id              String   @id @default(uuid())
  name            String   @unique
  code            String   @unique
  description     String?
  monthlyPrice    Decimal  @default(0) @db.Decimal(10, 2)
  quarterlyPrice  Decimal  @default(0) @db.Decimal(10, 2)
  halfYearlyPrice Decimal  @default(0) @db.Decimal(10, 2)
  yearlyPrice     Decimal  @default(0) @db.Decimal(10, 2)
  currency        String   @default("INR")
  maxGyms         Int      @default(1)
  maxMembers      Int?
  maxTrainers     Int?
  maxStaff        Int?
  maxBranches     Int      @default(1)
  maxClasses      Int?
  maxStorageMB    Int?
  advancedReports Boolean  @default(false)
  features        String   @default("[]") // JSON array of feature codes
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subscriptions GymSubscription[]
  invoices      SubscriptionInvoice[]
}

// =====================================================================
// GYM SUBSCRIPTIONS (SaaS billing lifecycle)
// =====================================================================

model GymSubscription {
  id                 String    @id @default(uuid())
  // PENDING, TRIAL, ACTIVE, PAST_DUE, GRACE_PERIOD, EXPIRED, SUSPENDED, CANCELLED
  status             String    @default("PENDING")
  startDate          DateTime
  endDate            DateTime
  amount             Decimal   @db.Decimal(10, 2)
  billingCycle       String    @default("MONTHLY") // MONTHLY, QUARTERLY, HALF_YEARLY, YEARLY
  paymentMethod      String?
  razorpayOrderId    String?
  razorpayPaymentId  String?
  paidAt             DateTime?
  trialEndsAt        DateTime?
  gracePeriodEnd     DateTime?
  autoRenew          Boolean   @default(false)
  cancelledAt        DateTime?
  cancellationReason String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  gymId  String
  gym    Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  planId String
  plan   SaaSPlan @relation(fields: [planId], references: [id])

  invoices SubscriptionInvoice[]

  @@index([gymId])
  @@index([status])
  @@index([endDate])
  @@index([razorpayOrderId])
}

// =====================================================================
// SaaS INVOICES
// =====================================================================

model SubscriptionInvoice {
  id             String    @id @default(uuid())
  invoiceNumber  String    @unique
  gymName        String
  ownerName      String
  billingAddress String?
  gstin          String?
  planName       String
  billingPeriod  String // e.g., "Jan 2026" or "Q1 2026"
  subtotal       Decimal   @default(0) @db.Decimal(10, 2)
  taxRate        Decimal   @default(0) @db.Decimal(5, 2)
  taxAmount      Decimal   @default(0) @db.Decimal(10, 2)
  cgst           Decimal   @default(0) @db.Decimal(10, 2)
  sgst           Decimal   @default(0) @db.Decimal(10, 2)
  igst           Decimal   @default(0) @db.Decimal(10, 2)
  discount       Decimal   @default(0) @db.Decimal(10, 2)
  total          Decimal   @db.Decimal(10, 2)
  status         String    @default("PENDING") // PENDING, PAID, OVERDUE, CANCELLED
  paymentMethod  String?
  transactionId  String?
  issueDate      DateTime  @default(now())
  dueDate        DateTime
  paidAt         DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  gymId          String
  subscriptionId String
  subscription   GymSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  Gym            Gym             @relation(fields: [gymId], references: [id])
  SaaSPlan       SaaSPlan?       @relation(fields: [saaSPlanId], references: [id])
  saaSPlanId     String?

  @@index([gymId])
  @@index([subscriptionId])
  @@index([status])
  @@index([invoiceNumber])
}

// =====================================================================
// WORKOUTS
// =====================================================================

model WorkoutSlip {
  id           String    @id @default(uuid())
  title        String?
  exercises    String
  assignedDate DateTime  @default(now())
  validUntil   DateTime?

  memberId  String
  member    MemberDetails   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  trainerId String?
  trainer   TrainerDetails? @relation(fields: [trainerId], references: [id], onDelete: SetNull)
  gymId     String
  gym       Gym             @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@index([memberId])
}

// =====================================================================
// ATTENDANCE
// =====================================================================

model Attendance {
  id       String    @id @default(uuid())
  checkIn  DateTime  @default(now())
  checkOut DateTime?
  status   String    @default("PRESENT") // PRESENT, ABSENT
  source   String? // MANUAL, QR, BIOMETRIC
  branchId String?

  memberId String?
  member   MemberDetails? @relation(fields: [memberId], references: [id], onDelete: Cascade)
  staffId  String?
  staff    StaffDetails?  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  gymId    String
  gym      Gym            @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId, checkIn])
  @@index([memberId, checkIn])
  @@index([staffId, checkIn])
}

// =====================================================================
// ENQUIRIES / CRM LEADS
// =====================================================================

model Enquiry {
  id            String    @id @default(uuid())
  name          String
  phone         String
  email         String?
  notes         String?
  status        String    @default("NEW") // NEW, CONTACTED, INTERESTED, TRIAL, NEGOTIATION, CONVERTED, LOST
  source        String? // WALK_IN, WEBSITE, INSTAGRAM, FACEBOOK, WHATSAPP, REFERRAL, PHONE, ADVERTISEMENT, OTHER
  followUpDate  DateTime?
  expectedValue Float?
  convertedAt   DateTime?
  leadOwner     String?
  date          DateTime  @default(now())

  gymId String
  gym   Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId, status])
}

// =====================================================================
// NOTICES
// =====================================================================

model Notice {
  id        String   @id @default(uuid())
  title     String
  content   String
  createdAt DateTime @default(now())

  gymId String
  gym   Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId])
}

// =====================================================================
// PLATFORM CMS
// =====================================================================

model FAQ {
  id        String   @id @default(uuid())
  question  String
  answer    String
  category  String? // GENERAL, BILLING, MEMBERSHIP, BOOKING, TECH, etc.
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, order])
}

model Testimonial {
  id        String   @id @default(uuid())
  name      String
  role      String
  content   String
  imageUrl  String?
  gymName   String? // originating gym for credibility context
  rating    Int      @default(5)
  featured  Boolean  @default(false) // pinned to the public homepage
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, featured])
}

// Keyed site content rendered on the public website (hero, features, pricing,
// announcement banners, etc.). `value` holds plain text or a JSON string;
// `section` groups entries for the UI. Managed by Super Admins in the CMS tab.
model SiteContent {
  id        String   @id @default(uuid())
  key       String   @unique // e.g. hero_title, hero_subtitle, announcement, pricing_banner
  value     String   @default("")
  section   String? // HERO, FEATURES, PRICING, ABOUT, FOOTER, ANNOUNCEMENT, etc.
  isActive  Boolean  @default(true)
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

// =====================================================================
// SUPPORT TICKETS
// =====================================================================

model SupportTicket {
  id        String   @id @default(uuid())
  subject   String
  category  String? // BILLING, TECHNICAL, FEATURE_REQUEST, GENERAL
  message   String
  status    String   @default("OPEN") // OPEN, IN_PROGRESS, WAITING_FOR_CUSTOMER, RESOLVED, CLOSED
  priority  String   @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// =====================================================================
// AUDIT LOGS
// =====================================================================

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  entity    String
  entityId  String?
  details   String?
  ipAddress String?
  userAgent String?
  gymId     String?
  createdAt DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([gymId])
  @@index([action])
  @@index([createdAt])
  @@index([gymId, action, createdAt])
}

// =====================================================================
// PT BOOKINGS
// =====================================================================

model Booking {
  id        String   @id @default(uuid())
  date      String
  time      String
  status    String   @default("PENDING") // PENDING, CONFIRMED, COMPLETED, CANCELLED
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    String
  user      User   @relation("MemberBookings", fields: [userId], references: [id], onDelete: Cascade)
  trainerId String
  trainer   User   @relation("TrainerBookings", fields: [trainerId], references: [id], onDelete: Cascade)
  gymId     String
  gym       Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@unique([trainerId, date, time])
  @@unique([userId, date, time])
  @@index([gymId])
  @@index([trainerId])
}

// =====================================================================
// PROGRESS & NUTRITION
// =====================================================================

model ProgressLog {
  id       String   @id @default(uuid())
  weight   Float
  height   Float?
  bodyFat  Float?
  chest    Float?
  waist    Float?
  hips     Float?
  arms     Float?
  thighs   Float?
  notes    String?
  photoUrl String?
  date     DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model NutritionPlan {
  id        String   @id @default(uuid())
  title     String
  calories  Int?
  protein   Float?
  carbs     Float?
  fats      Float?
  meals     String   @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// =====================================================================
// CLASS / GROUP FITNESS MANAGEMENT
// =====================================================================

model GymClass {
  id          String   @id @default(uuid())
  name        String // Yoga, Zumba, CrossFit, HIIT, etc.
  description String?
  capacity    Int      @default(20)
  duration    Int      @default(60) // minutes
  dayOfWeek   String? // MONDAY, TUESDAY, etc.
  startTime   String? // HH:mm
  endTime     String? // HH:mm
  location    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  gymId     String
  gym       Gym             @relation(fields: [gymId], references: [id], onDelete: Cascade)
  trainerId String?
  trainer   TrainerDetails? @relation(fields: [trainerId], references: [id], onDelete: SetNull)
  branchId  String?
  branch    Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  bookings  ClassBooking[]

  @@index([gymId])
  @@index([branchId])
}

model ClassBooking {
  id        String   @id @default(uuid())
  status    String   @default("BOOKED") // BOOKED, ATTENDED, CANCELLED, WAITLISTED
  notes     String?
  createdAt DateTime @default(now())

  memberId String
  member   MemberDetails @relation(fields: [memberId], references: [id], onDelete: Cascade)
  classId  String
  gymClass GymClass      @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([memberId, classId])
  @@index([classId])
  @@index([memberId])
}

// =====================================================================
// INVENTORY / PRODUCTS (POS)
// =====================================================================

model ProductCategory {
  id        String   @id @default(uuid())
  name      String
  gymId     String
  createdAt DateTime @default(now())

  products Product[]

  @@index([gymId])
}

model Supplier {
  id        String   @id @default(uuid())
  name      String
  phone     String?
  email     String?
  address   String?
  gymId     String
  createdAt DateTime @default(now())

  products Product[]

  @@index([gymId])
}

model Product {
  id            String    @id @default(uuid())
  name          String
  sku           String?
  description   String?
  purchasePrice Decimal   @default(0) @db.Decimal(10, 2)
  sellingPrice  Decimal   @default(0) @db.Decimal(10, 2)
  stock         Int       @default(0)
  minimumStock  Int       @default(5)
  expiryDate    DateTime?
  batchNumber   String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  gymId      String
  gym        Gym              @relation(fields: [gymId], references: [id], onDelete: Cascade)
  categoryId String?
  category   ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  supplierId String?
  supplier   Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  saleItems  SaleItem[]

  @@index([gymId])
  @@index([categoryId])
  @@index([sku])
}

model Sale {
  id            String   @id @default(uuid())
  total         Decimal  @db.Decimal(10, 2)
  discount      Decimal  @default(0) @db.Decimal(10, 2)
  tax           Decimal  @default(0) @db.Decimal(10, 2)
  finalAmount   Decimal  @db.Decimal(10, 2)
  paymentMethod String?
  status        String   @default("COMPLETED") // COMPLETED, REFUNDED, PARTIAL
  receiptNumber String?
  notes         String?
  createdAt     DateTime @default(now())

  gymId String
  gym   Gym        @relation(fields: [gymId], references: [id], onDelete: Cascade)
  items SaleItem[]

  @@index([gymId])
}

model SaleItem {
  id        String  @id @default(uuid())
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  total     Decimal @db.Decimal(10, 2)

  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([productId])
}

// =====================================================================
// EXPENSES
// =====================================================================

model Expense {
  id          String   @id @default(uuid())
  category    String // RENT, ELECTRICITY, INTERNET, SALARIES, MAINTENANCE, EQUIPMENT, MARKETING, CLEANING, SOFTWARE, MISC
  description String
  amount      Decimal  @db.Decimal(10, 2)
  date        DateTime @default(now())
  isRecurring Boolean  @default(false)
  receiptUrl  String?
  notes       String?
  createdAt   DateTime @default(now())

  gymId String
  gym   Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@index([category])
  @@index([date])
  @@index([gymId, date])
}

// =====================================================================
// EQUIPMENT MANAGEMENT
// =====================================================================

model Equipment {
  id             String    @id @default(uuid())
  name           String
  serialNumber   String?
  purchaseDate   DateTime?
  purchaseCost   Decimal?  @db.Decimal(10, 2)
  warrantyExpiry DateTime?
  location       String?
  condition      String    @default("OPERATIONAL") // OPERATIONAL, MAINTENANCE, DAMAGED, RETIRED
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  gymId           String
  gym             Gym                    @relation(fields: [gymId], references: [id], onDelete: Cascade)
  maintenanceLogs EquipmentMaintenance[]

  @@index([gymId])
  @@index([condition])
}

model EquipmentMaintenance {
  id          String    @id @default(uuid())
  type        String // PREVENTIVE, CORRECTIVE, INSPECTION
  description String
  cost        Decimal   @default(0) @db.Decimal(10, 2)
  date        DateTime  @default(now())
  nextDue     DateTime?
  createdAt   DateTime  @default(now())

  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@index([equipmentId])
}

// =====================================================================
// PAYROLL
// =====================================================================

model Payslip {
  id            String    @id @default(uuid())
  month         Int // 1-12
  year          Int
  basicSalary   Decimal   @db.Decimal(10, 2)
  bonuses       Decimal   @default(0) @db.Decimal(10, 2)
  deductions    Decimal   @default(0) @db.Decimal(10, 2)
  netPay        Decimal   @db.Decimal(10, 2)
  paymentMethod String?
  status        String    @default("PENDING") // PENDING, PAID
  paidAt        DateTime?
  notes         String?
  createdAt     DateTime  @default(now())

  gymId  String
  gym    Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@index([userId])
  @@index([month, year])
}

// =====================================================================
// REFERRALS
// =====================================================================

model Referral {
  id             String   @id @default(uuid())
  referralCode   String
  rewardType     String? // FREE_DAYS, DISCOUNT, PT_SESSION
  rewardValue    Decimal? @db.Decimal(10, 2)
  status         String   @default("PENDING") // PENDING, COMPLETED, REWARDED
  referredUserId String?
  createdAt      DateTime @default(now())

  referrerUserId String
  gymId          String

  @@index([referralCode])
  @@index([referrerUserId])
  @@index([gymId])
}

// =====================================================================
// FEATURE FLAGS (Super Admin)
// =====================================================================

model FeatureFlag {
  id              String   @id @default(uuid())
  key             String   @unique
  name            String
  description     String?
  isEnabled       Boolean  @default(false)
  planRestriction String? // JSON array of plan codes that get this feature
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// =====================================================================
// PLATFORM MESSAGES (contact form — NOT tenant-scoped)
// =====================================================================
// Public contact-form submissions are stored here so they never pollute a
// tenant's enquiry pipeline (they are addressed to the platform, not a gym).
// Super Admins can view these in the admin console.

model PlatformMessage {
  id        String   @id @default(uuid())
  name      String
  phone     String?
  email     String
  subject   String?
  message   String
  status    String   @default("NEW") // NEW, READ, ARCHIVED
  createdAt DateTime @default(now())

  @@index([status, createdAt])
}

// =====================================================================
// PARTNER WEBSITES (paid add-on)
// =====================================================================

model GymWebsiteRequest {
  id          String   @id @default(uuid())
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED
  desiredSlug String   @unique
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  gymId String
  gym   Gym    @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([gymId])
}

// =====================================================================
// BACKGROUND JOBS (polled by the scheduler / cron)
// =====================================================================

model Job {
  id          String   @id @default(uuid())
  type        String // EMAIL, ...
  payload     Json     @default("{}")
  status      String   @default("QUEUED") // QUEUED, RUNNING, DONE, FAILED
  attempts    Int      @default(0)
  maxAttempts Int      @default(5)
  runAt       DateTime @default(now())
  lastError   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, runAt])
}

// =====================================================================
// DOCUMENTS (private uploads, served only through signed links)
// =====================================================================

model Document {
  id         String   @id @default(uuid())
  kind       String // ID_PROOF, BUSINESS_PROOF, GST_CERT, QUALIFICATION, GALLERY
  storageKey String   @unique
  mime       String
  sizeBytes  Int
  sha256     String
  status     String   @default("UPLOADED") // UPLOADED, VERIFIED, REJECTED, DELETED
  createdAt  DateTime @default(now())

  ownerUserId String
  owner       User    @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  gymId       String?
  gym         Gym?    @relation(fields: [gymId], references: [id], onDelete: SetNull)

  approvals      ApprovalDocument[]
  qualifications TrainerQualification[]

  @@index([ownerUserId])
  @@index([gymId])
}

// =====================================================================
// APPROVALS (one engine for every change that needs a reviewer)
// =====================================================================
// The real tables only hold approved data; a proposed change waits in
// proposedValue until a reviewer approves it.

model ApprovalRequest {
  id            String    @id @default(uuid())
  seq           Int       @unique @default(autoincrement())
  ref           String    @unique // APR-2026-000123
  type          String // GYM_REGISTRATION, GYM_PROFILE_CHANGE, PAYOUT_ACCOUNT, PLAN_PRICE_CHANGE, TRAINER_VERIFICATION, ACCOUNT_REACTIVATION, BRANCH, WEBSITE_SLUG
  resourceType  String // Gym, MembershipPlan, TrainerDetails, User
  resourceId    String
  status        String    @default("DRAFT") // DRAFT, PENDING_REVIEW, CHANGES_REQUESTED, APPROVED, REJECTED, CANCELLED
  currentValue  Json?
  proposedValue Json?
  // "type:resourceType:resourceId" while open and null once closed, so the
  // unique index allows one open request per resource and type.
  openKey       String?   @unique
  requesterRole String
  reviewNote    String?
  submittedAt   DateTime?
  decidedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  gymId       String?
  gym         Gym?    @relation(fields: [gymId], references: [id], onDelete: Cascade)
  requesterId String
  requester   User    @relation("ApprovalRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  reviewerId  String?
  reviewer    User?   @relation("ApprovalReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  events    ApprovalEvent[]
  documents ApprovalDocument[]

  @@index([status, type])
  @@index([gymId])
  @@index([requesterId])
}

// Append-only history of every status change.
model ApprovalEvent {
  id         String   @id @default(uuid())
  fromStatus String?
  toStatus   String
  note       String?
  createdAt  DateTime @default(now())

  requestId String
  request   ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?           @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([requestId])
}

model ApprovalDocument {
  requestId  String
  request    ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  documentId String
  document   Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([requestId, documentId])
  @@index([documentId])
}

// Platform list of facilities a gym can pick from, managed by the super admin.
model Facility {
  id        String   @id @default(uuid())
  name      String   @unique
  icon      String?
  createdAt DateTime @default(now())
}
