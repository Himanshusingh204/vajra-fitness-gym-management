# Vajra Fitness — Environment Variables
#
# NEVER commit real secrets. Copy the backend block into `backend/.env` and the
# frontend block into `frontend/.env` (both are gitignored).
#
# All monetary values in the database use Decimal (Prisma Decimal → PostgreSQL numeric).
# All timestamps are stored in UTC and displayed according to user timezone preferences.

# ---------------------------------------------------------------------------
# Backend — copy to backend/.env
# ---------------------------------------------------------------------------

# Server port
PORT=5000

# Environment: development | test | staging | production
NODE_ENV=development

# PostgreSQL connection string. Point at any local Postgres instance, or a
# free Neon project for both local dev and production (see DEPLOYMENT.md).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vajra_fitness?schema=public"

# JWT secret must be at least 32 characters (enforced at startup).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change_me_to_a_64_char_random_hex_secret_before_going_live"

# Frontend origin (used for activation links, reset links, CORS, and cookie SameSite)
FRONTEND_URL="http://localhost:5173"

# Additional CORS origins (comma-separated). FRONTEND_URL is always allowed.
CORS_ORIGINS=""

# Set to 1 (or number of proxy hops) when deployed behind nginx / Cloud Run / load balancer.
# Required for accurate rate limiting by real client IP.
TRUST_PROXY="0"

# SMTP — REQUIRED in production. Without SMTP, activation and reset links are logged to console.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Vajra Fitness <no-reply@example.com>"

# Razorpay (primary Indian payment provider). Leave empty to disable online payments.
# When disabled, members see "contact the front desk" and admins record offline payments.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Optional: Redis URL for distributed rate limiting, session sharing, and job queues.
# Leave empty for single-instance in-memory state.
REDIS_URL=""

# ---------------------------------------------------------------------------
# Frontend — copy to frontend/.env
# ---------------------------------------------------------------------------
VITE_API_URL="http://localhost:5000/api"

# Optional: Web Vitals endpoint. Leave empty to disable.
VITE_WEB_VITALS_ENDPOINT=""

# Optional: Plausible analytics domain (privacy-friendly, opt-in).
# Uncomment only when deploying to a real domain and analytics consent is implemented.
# VITE_PLAUSIBLE_DOMAIN="your-site.com"

# ---------------------------------------------------------------------------
# Security Notes
# ---------------------------------------------------------------------------
# 1. Only VITE_* variables are exposed to the browser.
# 2. Never put JWT_SECRET, DATABASE_URL, SMTP_PASS, RAZORPAY_* in frontend .env.
# 3. Replace demo credentials (admin@vajrafitness.com / gym123 / Demo@1234) after first deploy.
# 4. For production, set HTTPS, HSTS, and SameSite=Strict cookies (already configured in Helmet).
# ---------------------------------------------------------------------------
