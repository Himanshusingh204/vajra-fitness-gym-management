# Optional overrides for docker-compose.yml. Everything here already has the
# same default inside the compose file, so the stack starts without this file.
# To change something: cp docker.env.example .env  (.env is gitignored)
#
# These are local-development values only. Never reuse them anywhere public.

# Postgres
POSTGRES_USER=vajra_admin
POSTGRES_PASSWORD=vajra_secure_pass
POSTGRES_DB=vajra_fitness

# Must be at least 32 characters. Generate a fresh one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=local_only_jwt_secret_change_me_0123456789abcdef

# Host ports. Postgres is on 5433 so it does not clash with a local install.
WEB_PORT=8080
API_PORT=5000
DB_PORT=5433
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# "production" matches the deployed API (Secure cookies, no dev links in
# responses). Safari rejects Secure cookies on plain http, so set this to
# "development" if you test the stack in Safari.
API_NODE_ENV=production

# Mail goes to Mailpit (http://localhost:8025), nothing leaves your machine.
SMTP_FROM=Vajra Fitness <no-reply@localhost>

# Leave empty to keep online payments disabled.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
