# Copy to .env.local. EXPO_PUBLIC_ values are bundled into the app, so never put secrets here.
# On a phone, "localhost" is the phone itself: use your computer's LAN address for a local API.
EXPO_PUBLIC_API_URL=https://vajra-fitness-gym-management.vercel.app/api
# The website, used for links such as partner signup.
EXPO_PUBLIC_SITE_URL=https://vajra-fitness-gym-management.vercel.app
